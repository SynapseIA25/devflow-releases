{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevFlow",
  "version": "0.7.0",
  "identifier": "com.devflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevFlow",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/opencode"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "sign-windows.ps1", "%1"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pab-1984/devflow-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzRTMyMjA5NDUwQTY4NTEKUldSUmFBcEZDU0xqZzlXUVhWT0wvMzZpcWM2eUZuMHpYUldWQ3RwdXY0ZXBkZDBsMlplSE8xZFUK"
    }
  }
}
